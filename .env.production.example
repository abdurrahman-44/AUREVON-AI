# ==============================================================================
# AUREVON AI — Public Production Deployment Environment Template
# Decoupled from local laptop inference: uses PostgreSQL 16 + hosted AI endpoint.
# Copy to .env on your production server and set strong unique secrets.
# ==============================================================================

APP_NAME="AUREVON AI"
APP_ENV=production
DEBUG=false
ENABLE_DOCS=false
HOST=0.0.0.0
PORT=8000

# Restrict CORS to your exact deployed HTTPS domain(s)
CORS_ORIGINS=["https://ai.yourdomain.com"]

# PostgreSQL 16 Credentials (used by docker-compose.yml & Alembic)
POSTGRES_DB=aurevon
POSTGRES_USER=aurevon
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
DATABASE_URL=postgresql+asyncpg://aurevon:REPLACE_WITH_STRONG_DB_PASSWORD@db:5432/aurevon

# Security & Owner Bootstrap
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_SECRET
# Required for remote web/API first-owner bootstrap when APP_ENV=production:
ADMIN_BOOTSTRAP_TOKEN=REPLACE_WITH_ONE_TIME_BOOTSTRAP_TOKEN

# Hosted Cloud / Dedicated Inference Endpoint (decoupled from developer laptop)
# Option A: Hosted OpenAI-compatible runtime (vLLM, Together, Fireworks, OpenRouter, etc.)
PRODUCTION_INFERENCE_PROVIDER=production
PRODUCTION_INFERENCE_URL=https://api.groq.com/openai/v1
PRODUCTION_INFERENCE_API_KEY=REPLACE_WITH_HOSTED_INFERENCE_KEY
PRODUCTION_DEFAULT_MODEL=llama-3.1-8b-instant

# Option B: Direct provider defaults if not using PRODUCTION_INFERENCE_URL
DEFAULT_PROVIDER=production
DEFAULT_MODEL=llama-3.1-8b-instant
MODEL_CONTEXT_WINDOW=8192
GENERATION_TEMPERATURE=0.7
PIN_DEFAULT_MODEL=true
ALLOW_USER_MODEL_SWITCHING=false

# Optional Self-Hosted Fallback (only if running private remote Ollama via compose profile)
OLLAMA_BASE_URL=http://ollama:11434

# Optional Secondary Cloud Keys (server-side only; leave blank if unused)
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Persistent Storage & Sliding-Window Rate Limiting
UPLOAD_DIR=/app/storage/uploads
MAX_UPLOAD_SIZE_MB=25
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_AUTH_PER_MINUTE=15
RATE_LIMIT_UPLOAD_PER_MINUTE=20
RATE_LIMIT_ADMIN_TERMINAL_PER_MINUTE=30
ADMIN_SESSION_EXPIRE_MINUTES=720
LOG_RETENTION_DAYS_DEFAULT=30
