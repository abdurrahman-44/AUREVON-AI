# ==============================================================================
# AUREVON AI — Environment Configuration
# ==============================================================================

# Application
APP_NAME="AUREVON AI"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="127.0.0.1"
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database Configuration
# Primary: PostgreSQL (e.g. postgresql+asyncpg://postgres:postgres@localhost:5432/aurevon_ai)
# Local fallback / dev: sqlite+aiosqlite:///./aurevon.db
DATABASE_URL="sqlite+aiosqlite:///./aurevon.db"

# Local AI Provider (Ollama)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
DEFAULT_MODEL="qwen2.5:3b"
MODEL_CONTEXT_WINDOW=8192
GENERATION_TEMPERATURE=0.7

# Security & Storage
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
UPLOAD_DIR="./storage/uploads"
MAX_UPLOAD_SIZE_MB=25
