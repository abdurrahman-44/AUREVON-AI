# ==============================================================================
# AUREVON AI — Local Development Environment Template
# Copy this file to backend/.env (never commit backend/.env to version control).
# ==============================================================================

APP_NAME="AUREVON AI"
APP_ENV=development
DEBUG=true
ENABLE_DOCS=true
HOST=127.0.0.1
PORT=8000

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Primary Local Database (SQLite preserves existing local records cleanly)
DATABASE_URL=sqlite+aiosqlite:///./aurevon.db

# Intelligence Core & Local Runtime (Ollama on modest CPU/RAM hardware)
DEFAULT_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_MODEL=qwen2.5:3b
MODEL_CONTEXT_WINDOW=8192
GENERATION_TEMPERATURE=0.7
PIN_DEFAULT_MODEL=true
ALLOW_USER_MODEL_SWITCHING=false

# Security & Owner Bootstrap (replace SECRET_KEY before sharing or deploying)
SECRET_KEY=dev-secret-key-change-in-production-12345
# Optional one-time token for first-owner web/API bootstrap in production mode:
ADMIN_BOOTSTRAP_TOKEN=

# Optional Server-Side Cloud Keys (never exposed to the frontend)
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# File Storage & Rate Limiting
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=25
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_AUTH_PER_MINUTE=15
RATE_LIMIT_UPLOAD_PER_MINUTE=20
RATE_LIMIT_ADMIN_TERMINAL_PER_MINUTE=30
ADMIN_SESSION_EXPIRE_MINUTES=720
LOG_RETENTION_DAYS_DEFAULT=30
